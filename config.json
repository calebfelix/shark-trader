{
  "symbol": "XAUINR",
  "base_url": "https://api.sharkexchange.in",
  "dry_run": true,
  "poll_seconds": 60,

  "account_capital": 2000.0,
  "risk_per_trade_pct": 1.0,

  "leverage": {
    "value": 20,
    "margin_mode": "ISOLATED",
    "allow_min_notional_override": false
