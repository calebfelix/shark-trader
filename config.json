      "take_profit_pct": 0.8,
      "entry_limit_offset_pct": 0.02,
      "min_profit_to_fee_ratio": 3.0
    },
    "sma": {
      "kline_interval": "1m",
      "fast_period": 9,
      "slow_period": 21,
      "stop_loss_pct": 1.5,
      "take_profit_pct": 3.0
    },
    "scalp": {
      "kline_interval": "1m",
      "bb_period": 10,
      "bb_stddev": 2.0,
      "rsi_period": 7,
      "rsi_oversold": 25,
